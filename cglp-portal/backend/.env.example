PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=cglp_portal
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend URL (used in emails and QR verification links)
FRONTEND_URL=http://localhost:5173

# Gmail SMTP for email notifications.
# GMAIL_USER is your full Gmail address.
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT your normal Gmail
# password. Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for your Google account).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Anthropic API key for the customer-inquiry chatbot.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key
